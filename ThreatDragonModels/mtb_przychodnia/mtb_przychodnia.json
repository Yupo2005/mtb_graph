              "privilegeLevel": "Medium",
              "threats": [
                {
                  "id": "threat-s-1",
                  "title": "Podszycie pod konto personelu (Spoofing)",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "Przejęcie ciasteczka sesyjnego lub atak brute-force na moduł logowania aplikacji gabinetowej.",
                  "mitigation": "Wymuszenie MFA, polityka blokowania kont po błędnych próbach, flagi HttpOnly, Secure, SameSite=Strict."
                },
                {
                  "id": "threat-d-1",
                  "title": "Wyczerpanie zasobów aplikacji (Denial of Service)",
                  "type": "Denial of service",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Wywołanie kosztownych operacji generowania raportów bez paginacji powodujące brak odpowiedzi serwera.",
                  "mitigation": "Wdrożenie limitów rate limiting, timeouty zapytań backendowych, asynchroniczne kolejkowanie generowania raportów."
                },
                {
                  "id": "threat-e-1",
                  "title": "Eskalacja uprawnień (Elevation of Privilege)",
                  "type": "Elevation of privilege",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Błędy kontroli dostępu (BOLA / IDOR) umożliwiające roli rejestratorki edycję rozpoznań medycznych lekarza.",
                  "mitigation": "Ścisła weryfikacja uprawnień RBAC na poziomie obiektów po stronie backendu."
                }
              ]
            }
